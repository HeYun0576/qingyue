{
  "name": "qingyue-markdown",
  "version": "1.3.4",
  "description": "轻阅",
  "repository": "https://github.com/HeYun0576/qingyue",
  "main": "electron/main.cjs",
  "author": "Local Software",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "dev:app": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "build:web": "vite build",
    "build:lite": "cross-env QINGYUE_EDITION=lite vite build",
    "stage:lite": "node scripts/stage-lite.cjs",
    "build": "pnpm run typecheck && pnpm run test && pnpm run build:web",
    "dist:portable": "pnpm run build && electron-builder --win portable --x64 --publish never",
    "dist:installer": "pnpm run build && electron-builder --win nsis --x64 --publish never",
    "dist:lite:portable": "pnpm run build:lite && pnpm run stage:lite && electron-builder --projectDir release/lite-stage --win portable --x64 --publish never",
    "dist:lite:installer": "pnpm run build:lite && pnpm run stage:lite && electron-builder --projectDir release/lite-stage --win nsis --x64 --publish never",
    "dist:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-fast-portable.ps1 -Edition full",
    "dist:lite:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-fast-portable.ps1 -Edition lite",
    "verify:update": "node scripts/verify-update-artifacts.cjs"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3",
    "mammoth": "^1.12.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "^8.20.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "diff": "^9.0.0",
    "dompurify": "^3.4.13",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-katex": "^2.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-mind-map": "0.14.0-fix.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.local.qingyue.markdown",
    "productName": "轻阅",
    "executableName": "QingYue",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "publish": {
        "provider": "github",
        "owner": "HeYun0576",
        "repo": "qingyue",
        "channel": "latest"
      }
    },
    "portable": {
      "artifactName": "QingYue-Markdown-${version}-Portable-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "QingYue-Markdown-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "轻阅",
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
